/package-lock.json
# Scratch directories: a second Joy checkout (the Joy platform ships by release-bundle URL now),
# generated docs, a
# Golem temp dir, agent scratch, and a stale copy of the e2e suites (the live ones are
# roc-frontend/tests/e2e/).
/joy/
/generated-docs/
/golem-temp/
/roc-agents/
/tests/e2e/
