# Environment for the deployed stack: every name `docker-compose.yml` interpolates, grouped by the
# service that reads it. Copy to `devops/.env` and fill in the values — Dokploy/Infisical supplies the
# same names in production, and `docker run --env-file devops/.env` does for a local run of the image.
#
# The `app` service also reads `BIND_HOST`, `STATIC_DIR` and `DEV_MODE`, but the compose file sets
# those literally: loopback-only would be unreachable from Traefik, and `DEV_MODE=false` is what turns
# the local auth bypass off, so they are not configurable here. Placeholders only — never commit a real
# credential.

# --- SurrealDB (`surrealdb`) and the app's connection ---
# The credentials the database is started with, reused by the app.
SURREAL_USER=root
SURREAL_PASS=placeholder-db-password
# Namespace and database the app reads and writes: ns `main`, db `lessons` in production.
SURREAL_DB_NS=main
SURREAL_DB=lessons
# Optional, passed to the `surrealdb` container as they are.
SURREAL_MCP_ALLOWED_HOSTS=
SURREAL_MCP_MAX_RESULT_BYTES=

# --- Roc app (`app` service, app.johnethel.school) ---
# The app reaches the database over the compose network, so APP_SURREAL_URL only needs setting when
# pointing it somewhere else.
APP_SURREAL_URL=http://surrealdb:8000/sql
AUTHENTIK_HOST=auth.johnethel.school
AUTHENTIK_ISSUER_URL=https://auth.johnethel.school/application/o/school-management-system/
# Authentik serves one userinfo endpoint per instance, not per application. The backend derives this
# from the issuer; setting it makes the deployed value explicit.
AUTHENTIK_USERINFO_URL=https://auth.johnethel.school/application/o/userinfo/
# Service-account token for the admin API: creating, renaming, disabling and deleting logins, and the
# identity columns of the user listing. Browsing the directory without it still answers, from the
# profile rows alone. Leave empty to disable those calls.
AUTHENTIK_SERVICE_ACCOUNT_TOKEN=
#
# Cloudflare R2 — passport photo uploads (`POST /api/upload-url`)
#
# The endpoint signs a short-lived URL the browser PUTs the photo to, so it needs all five
# values: the endpoint and bucket to address the object, the key pair to sign with (AWS SigV4),
# and the public base URL the stored `passport` value is built from. If any is missing the
# endpoint answers 503 naming the ones that are, rather than signing a URL that cannot work.
# (Kept shell-safe because `setup.sh` sources this file.)
R2_ENDPOINT_URL=https://ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=school-passports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# An r2.dev URL or a custom domain — the bucket's own public base, no trailing slash. The key is
# appended to it, e.g. https://cdn.example.com/student/passports/<id>.jpg
R2_PUBLIC_URL=https://cdn.example.com
#
# The bucket also needs a CORS policy allowing the browser's PUT from the app's origin. The production
# bucket (school-management-system, served from r2.johnethel.school) already answers the preflight with
# `Access-Control-Allow-Origin: *`, `Allow-Methods: PUT, DELETE` and `Allow-Headers: content-type`, which
# is what the upload form needs — verified end to end (signed PUT, public GET, a real browser upload).
# If a bucket is ever locked down, allow the app's origin for PUT with the content-type header.

# --- Matrix (`synapse`, `synapse-postgresql`), `element-web`, `coturn` ---
# The homeserver's own domain: Traefik's host rule for Synapse and coturn's realm.
SYNAPSE_SERVER_NAME=matrix.johnethel.school
POSTGRES_PASSWORD=placeholder-synapse-db-password
# Synapse's OIDC client against Authentik (see the README's Matrix OIDC section).
SYNAPSE_CLIENT_ID=placeholder-oidc-client-id
SYNAPSE_CLIENT_SECRET=placeholder-oidc-client-secret
# Secrets Synapse signs and validates with, and the shared one `register_new_matrix_user` needs.
SYNAPSE_MACAROON_SECRET=placeholder-macaroon-secret
SYNAPSE_FORM_SECRET=placeholder-form-secret
SYNAPSE_REGISTRATION_SECRET=placeholder-registration-secret
# The TURN secret coturn and Synapse must agree on.
COTURN_SHARED_SECRET=placeholder-turn-secret

# --- OpenCloud (`opencloud`) ---
# A separate product, not used by the app; the service starts only with these set.
OC_DOMAIN=files.example.com
OC_ADMIN_PASSWORD=placeholder-admin-password
OC_JWT_SECRET=placeholder-opencloud-jwt-secret
OC_MACHINE_AUTH_API_KEY=placeholder-machine-auth-key
OC_TRANSFER_SECRET=placeholder-transfer-secret
OC_SYSTEM_USER_API_KEY=placeholder-system-user-key
OC_SYSTEM_USER_ID=placeholder-system-user-id
# OpenCloud's own OIDC client, registered in Authentik like the others.
OC_OIDC_CLIENT_ID=placeholder-oidc-client-id
OC_OIDC_CLIENT_SECRET=placeholder-oidc-client-secret

# --- Legacy local run (`setup.sh` and `caddy/`), not `docker-compose.yml` ---
# The older `*.localhost` setup reads these instead — `setup.sh` copies this file to `.env` and
# sources it. Its Synapse secret names differ from the compose file's: `SYNAPSE_POSTGRES_PASSWORD`
# is `POSTGRES_PASSWORD` above, and `SYNAPSE_MACAROON_SECRET_KEY` and
# `SYNAPSE_REGISTRATION_SHARED_SECRET` are `SYNAPSE_MACAROON_SECRET` and `SYNAPSE_REGISTRATION_SECRET`.
DOMAIN=localhost
AUTH_DOMAIN=auth.staging.johnethel.school
MATRIX_DOMAIN=matrix.${DOMAIN}
CHAT_DOMAIN=chat.${DOMAIN}
SYNAPSE_POSTGRES_PASSWORD=synapse_db_password
SYNAPSE_MACAROON_SECRET_KEY=generate_a_random_string_here_for_macaroons
SYNAPSE_REGISTRATION_SHARED_SECRET=generate_a_random_string_here_for_registration

