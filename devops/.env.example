# Domain Configuration
DOMAIN=localhost
AUTH_DOMAIN=auth.staging.johnethel.school
MATRIX_DOMAIN=matrix.${DOMAIN}
CHAT_DOMAIN=chat.${DOMAIN}

# Synapse Secrets
SYNAPSE_POSTGRES_PASSWORD=synapse_db_password
SYNAPSE_MACAROON_SECRET_KEY=generate_a_random_string_here_for_macaroons
SYNAPSE_REGISTRATION_SHARED_SECRET=generate_a_random_string_here_for_registration

# Caddy
# Leave blank for local. Set to your email for Let's Encrypt in production
ACME_EMAIL=

# Roc app (`app` service, app.johnethel.school)
#
# SURREAL_USER / SURREAL_PASS are already required by the `surrealdb` service; the app reuses them.
# The app reaches the database over the compose network, so APP_SURREAL_URL only needs setting when
# pointing it somewhere else.
APP_SURREAL_URL=http://surrealdb:8000/sql
AUTHENTIK_HOST=auth.johnethel.school
AUTHENTIK_ISSUER_URL=https://auth.johnethel.school/application/o/school-management-system/
# Authentik serves one userinfo endpoint per instance, not per application. The backend derives this
# from the issuer; setting it makes the deployed value explicit.
AUTHENTIK_USERINFO_URL=https://auth.johnethel.school/application/o/userinfo/
# Service-account token for creating and deleting logins (`POST /api/users`); read-only browsing
# needs only the issuer above. Leave empty to disable user creation.
AUTHENTIK_SERVICE_ACCOUNT_TOKEN=

# Cloudflare R2 — passport photo uploads (`POST /api/upload-url`)
#
# The endpoint signs a short-lived URL the browser PUTs the photo to, so it needs all five
# values: the endpoint and bucket to address the object, the key pair to sign with (AWS SigV4),
# and the public base URL the stored `passport` value is built from. If any is missing the
# endpoint answers 503 naming the ones that are, rather than signing a URL that cannot work.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=school-passports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# An r2.dev URL or a custom domain — the bucket's own public base, no trailing slash. The key is
# appended to it, e.g. https://cdn.example.com/student/passports/<id>.jpg
R2_PUBLIC_URL=https://cdn.example.com
#
# The bucket also needs a CORS policy allowing the browser's PUT from the app's origin. The production
# bucket (school-management-system, served from r2.johnethel.school) already answers the preflight with
# `Access-Control-Allow-Origin: *`, `Allow-Methods: PUT, DELETE` and `Allow-Headers: content-type`, which
# is what the upload form needs — verified end to end (signed PUT, public GET, a real browser upload).
# If a bucket is ever locked down, allow the app's origin for PUT with the content-type header.
