# Everything the backend reads, all of it from the environment (`main.roc`, `Authentik.roc`,
# `Golem.roc`; `../docs/architecture.md` has the boundary rules). Copy and adjust:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   roc run main.roc
#
# `.env` is gitignored — keep it that way. The values below are placeholders, nothing more: a real
# token, password or key belongs in the environment, never in a file that can be committed.

# --- Server ---
# Loopback by default; a container, or any reverse proxy in another network namespace, needs
# 0.0.0.0.
BIND_HOST=127.0.0.1
PORT=8000
# The built frontend bundle, served by the same process (`../roc-frontend/build.roc` writes it).
STATIC_DIR=../roc-frontend/www
# `true` accepts the `dev-skip` token so local work and the sandbox suites need no Authentik login.
# Production runs `false`, which turns that bypass off completely.
DEV_MODE=true

# --- SurrealDB (`SurrealDB.roc`) ---
# A host-run database on its default port. Prod is `https://db2.johnethel.school/sql` (the code's own
# default, ns `main`, db `lessons`); the compose stack reaches `http://surrealdb:8000/sql`.
SURREAL_URL=http://localhost:8000/sql
SURREAL_DB_NS=main
SURREAL_DB=lessons
# Credentials, turned into one `Authorization: Basic …` header at startup. Without them (or
# SURREAL_AUTH) the server starts unauthenticated and warns.
SURREAL_USER=root
SURREAL_PASS=placeholder-db-password
# A complete `Authorization` value, used verbatim and winning over the pair above. Empty is normal:
# it means "build the Basic header from SURREAL_USER/SURREAL_PASS".
SURREAL_AUTH=

# --- Authentik (`Authentik.roc`) ---
# Token validation calls the **instance-wide** userinfo endpoint — `/application/o/userinfo/`, not
# `<issuer>userinfo`, which is a 404 and would reject every real token. Unset, it is derived from
# the issuer (`AuthUrls.roc`).
AUTHENTIK_USERINFO_URL=http://localhost:9000/application/o/userinfo/
# Where tokens come from, and what the userinfo URL above is derived from when it is unset.
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/school-management-system/
# The admin API for logins. A full URL wins; otherwise it is built from AUTHENTIK_HOST as
# `https://<AUTHENTIK_HOST>/api/v3/core/users/`.
AUTHENTIK_API_URL=http://localhost:9000/api/v3/core/users/
AUTHENTIK_HOST=localhost:9000
# Bearer token for those calls. `AUTHENTIK_API_TOKEN` wins; production injects the service-account
# token under that name (`../devops/docker-compose.yml`). Empty means no login is created or
# changed, and the user listing answers the database rows without the identity attributes (email,
# enabled state) rather than failing.
AUTHENTIK_API_TOKEN=
AUTHENTIK_SERVICE_ACCOUNT_TOKEN=

# --- Cloudflare R2 (`R2.roc`, `POST /api/upload-url`) ---
# Passport photos. All five are needed: the endpoint signs a short-lived URL the browser PUTs the
# photo to (endpoint + bucket to address the object, key pair to sign with), and the public base
# turns the stored key into the URL the page shows. Any missing one makes the endpoint answer 503
# naming it.
R2_ENDPOINT_URL=https://placeholder-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=school-passports
R2_ACCESS_KEY_ID=placeholder-access-key-id
R2_SECRET_ACCESS_KEY=placeholder-secret-access-key
# The bucket's public base, no trailing slash; the object key is appended to it.
R2_PUBLIC_URL=https://placeholder-bucket.r2.dev

# --- Other ---
# The homeserver `GET /api/matrix/token` hands the chat page.
PUBLIC_MATRIX_URL=https://matrix.example.com
# Read by `Golem.roc`, and only by the retired `/api/enroll` prototype in `main.roc` — nothing
# deploys a Golem runtime any more (`../devops/legacy/` holds the parked one).
GOLEM_URL=http://localhost:9006

